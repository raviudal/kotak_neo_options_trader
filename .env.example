# ==============================================================================
# NeoTrader Environment Configuration
# ==============================================================================

# Application Port and Host Binding
PORT=8080
HOST=0.0.0.0

# Secure Secret Key for JWT Authentication (Change this to a random 32+ character string in production)
# You can generate one via: python3 -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=replace-with-a-random-secure-secret-key-32-chars

# Token Expiry in Minutes (Default: 1440 mins = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Kotak Neo Broker Environment ('prod' for live trading, 'sandbox' for testing)
KOTAK_ENV=prod

# Seed Default Admin Account on first boot (true/false)
# Set to 'false' if you want a clean database and prefer registering via web UI directly
ADMIN_SEED=true
ADMIN_USERNAME=trader
ADMIN_PASSWORD=TradeSafe@2026

# Optional: Pre-configured Kotak Neo Credentials (can also be entered directly in the web UI)
# KOTAK_CONSUMER_KEY=your-consumer-key-from-kotak-developer-portal
# KOTAK_MOBILE_NUMBER=+91XXXXXXXXXX
# KOTAK_UCC=YOURUCC
